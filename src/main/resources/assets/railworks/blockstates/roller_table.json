{
  "multipart": [
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "railworks:block/roller_table"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "1|2|3"
      },
      "apply": {
        "model": "railworks:block/roller_table_axle"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "2|3"
      },
      "apply": {
        "model": "railworks:block/roller_table_wheel_a"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "3"
      },
      "apply": {
        "model": "railworks:block/roller_table_wheel_b"
      }
    },
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "railworks:block/roller_table",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "1|2|3"
      },
      "apply": {
        "model": "railworks:block/roller_table_axle",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "2|3"
      },
      "apply": {
        "model": "railworks:block/roller_table_wheel_a",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "3"
      },
      "apply": {
        "model": "railworks:block/roller_table_wheel_b",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "4|5|6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_axle"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "5|6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_wheel_a"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_wheel_b"
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "4|5|6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_axle",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "5|6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_wheel_a",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "6"
      },
      "apply": {
        "model": "railworks:block/roller_table_carriage_wheel_b",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "7|8|9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_a"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "8|9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_b"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_c"
      }
    },
    {
      "when": {
        "axis": "z",
        "press": "10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_d"
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "7|8|9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_a",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "8|9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_b",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "9|10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_c",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "press": "10"
      },
      "apply": {
        "model": "railworks:block/roller_table_beam_d",
        "y": 90
      }
    }
  ]
}